rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return isSignedIn() && data.clientId == request.auth.uid;
    }

    function ownsConnection(connectionId) {
      let path = /databases/$(database)/documents/connections/$(connectionId);
      return connectionId is string
        && exists(path)
        && get(path).data.clientId == request.auth.uid;
    }

    function hasExactly(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    function isNonEmptyString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    function isCreateStamped() {
      return request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isUpdateStamped() {
      return unchanged('createdAt') && request.resource.data.updatedAt == request.time;
    }

    function keepsTenant() {
      return unchanged('clientId') && unchanged('connectionId');
    }

    match /connections/{connectionId} {
      function isValidConnection(data) {
        return hasExactly(data, ['clientId', 'name', 'createdAt', 'updatedAt'])
          && isNonEmptyString(data.name, 80);
      }

      allow read: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data)
        && isValidConnection(request.resource.data)
        && isCreateStamped();
      allow update: if isOwner(resource.data)
        && unchanged('clientId')
        && isValidConnection(request.resource.data)
        && isUpdateStamped();
      allow delete: if isOwner(resource.data);
    }

    match /contacts/{contactId} {
      function isValidContact(data) {
        return hasExactly(data, ['clientId', 'connectionId', 'name', 'phone', 'createdAt', 'updatedAt'])
          && isNonEmptyString(data.name, 80)
          && data.phone is string
          && data.phone.matches('^[+]?[0-9]{8,15}$');
      }

      allow read: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data)
        && isValidContact(request.resource.data)
        && ownsConnection(request.resource.data.connectionId)
        && isCreateStamped();
      allow update: if isOwner(resource.data)
        && keepsTenant()
        && isValidContact(request.resource.data)
        && isUpdateStamped();
      allow delete: if isOwner(resource.data);
    }

    match /messages/{messageId} {
      function isValidMessage(data) {
        return hasExactly(data, [
            'clientId', 'connectionId', 'body', 'contactIds', 'status',
            'scheduledAt', 'sentAt', 'createdAt', 'updatedAt'
          ])
          && isNonEmptyString(data.body, 2000)
          && data.contactIds is list
          && data.contactIds.size() > 0
          && data.contactIds.size() <= 500
          && data.status in ['scheduled', 'sent']
          && (data.scheduledAt == null || data.scheduledAt is timestamp)
          && (data.sentAt == null || data.sentAt is timestamp);
      }

      function isSentNow(data) {
        return data.status == 'sent' && data.sentAt == request.time;
      }

      function isScheduledInFuture(data) {
        return data.status == 'scheduled'
          && data.scheduledAt is timestamp
          && data.scheduledAt > request.time
          && data.sentAt == null;
      }

      function isAllowedTransition() {
        return (resource.data.status == 'scheduled'
            && (isSentNow(request.resource.data) || isScheduledInFuture(request.resource.data)))
          || (resource.data.status == 'sent'
            && request.resource.data.status == 'sent'
            && unchanged('sentAt')
            && unchanged('scheduledAt'));
      }

      allow read: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data)
        && isValidMessage(request.resource.data)
        && ownsConnection(request.resource.data.connectionId)
        && (isSentNow(request.resource.data) || isScheduledInFuture(request.resource.data))
        && isCreateStamped();
      allow update: if isOwner(resource.data)
        && keepsTenant()
        && isValidMessage(request.resource.data)
        && isUpdateStamped()
        && isAllowedTransition();
      allow delete: if isOwner(resource.data);
    }
  }
}
